---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout title="Shares">
  <nav class="flex items-center gap-3 mb-6">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm no-underline text-[var(--glass-text-secondary)] bg-[var(--glass-bg-secondary)] shadow-sm rounded-lg px-3 py-1.5 border border-[var(--glass-border)] hover:bg-white/60 hover:text-gray-700 transition-colors"
    >
      &larr; 返回首页
    </a>
  </nav>

  <h1 class="text-3xl font-bold text-[var(--glass-text)] mb-2">Shares</h1>
  <p class="text-[var(--glass-text-secondary)] mb-8">Here are some useful resources and links that I want to share with you.</p>
  <!-- 先放一个占位内容，后面换成真实的分享列表 -->
  <div class="space-y-4">
    <a href="/shares/first-share" class="block ring-glow bg-[var(--glass-bg)] rounded-2xl p-6 shadow-lg border border-[var(--glass-border)] hover:shadow-xl transition-shadow no-underline">
      <h2 class="text-lg font-medium text-[var(--glass-text)] mt-1">还没有分享</h2>
      <p class="text-[var(--glass-text-secondary)] text-sm mt-1">第一个分享正在路上……</p>
    </a>
  </div>
</BaseLayout>