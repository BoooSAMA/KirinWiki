---
import BaseLayout from "../../layouts/BaseLayout.astro"

const postModules = import.meta.glob("../../content/categories/**/*.md", {
  eager: true,
}) as Record<string, { frontmatter: Record<string, any>; file: string }>

const categoryNames: Record<string, { zh: string; en: string }> = {
  "build-log": { zh: "建站日志", en: "Build Log" },
  blog: { zh: "默认", en: "Blog" },
  projects: { zh: "作品集", en: "Projects" },
  interview: { zh: "面试", en: "Interview" },
  game: { zh: "游戏", en: "Game" },
  music: { zh: "音乐", en: "Music" },
  AI: { zh: "AI", en: "AI" },
  bible: { zh: "圣经", en: "Bible" },
}

const categoryDescriptions: Record<string, { zh: string; en: string }> = {
  "build-log": {
    zh: "记录本站从零搭建的过程、技术选型与踩坑经验",
    en: "Build process, tech choices & lessons learned",
  },
  blog: {
    zh: "日常随笔与默认分类",
    en: "General posts & random thoughts",
  },
  projects: {
    zh: "个人作品展示，包含完整技术方案与实现细节",
    en: "Project showcases with tech details",
  },
  interview: {
    zh: "面试经验总结与算法、系统设计解析",
    en: "Interview prep & problem solving",
  },
  game: {
    zh: "游戏开发笔记，从玩法构思到技术实现",
    en: "Game dev notes & design thinking",
  },
  music: {
    zh: "乐理学习、乐器练习与音乐欣赏",
    en: "Music theory, practice & appreciation",
  },
  AI: {
    zh: "机器学习、深度学习与大模型应用学习笔记",
    en: "ML, DL & LLM learning notes",
  },
  bible: {
    zh: "探索圣经 — 文本研读、历史背景与神学主题",
    en: "Bible study — text, history & theology",
  },
}

// Group posts by category, count them
const categories: Record<string, { count: number }> = {}

for (const [filePath] of Object.entries(postModules)) {
  const parts = filePath.split("/")
  const cat = parts[parts.indexOf("categories") + 1]
  if (!categories[cat]) categories[cat] = { count: 0 }
  categories[cat].count++
}

const entries = Object.entries(categories)
---

<BaseLayout title="Blog">
  <nav class="flex items-center gap-3 mb-6">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm no-underline text-[var(--glass-text-secondary)] bg-[var(--glass-bg-secondary)] shadow-sm rounded-lg px-3 py-1.5 border border-[var(--glass-border)] hover:bg-white/60 hover:text-gray-700 transition-colors"
    >
      &larr; 返回首页
    </a>
  </nav>

  <h1 class="text-3xl font-bold text-[var(--glass-text)] mb-2">Blog</h1>
  <div class="flex items-center gap-4 mb-6">
    <p class="text-[var(--glass-text-secondary)]">选择分类</p>
    <a
      href="/blog/tags"
      class="text-sm no-underline text-[var(--glass-text-muted)] hover:text-[var(--glass-text-secondary)] transition-colors"
    >
      # 浏览标签
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      entries.map(([cat, info]) => {
        const name = categoryNames[cat] ?? { zh: cat, en: "" }
        const desc = categoryDescriptions[cat]
        return (
          <a
            href={`/blog/${cat}`}
            class="block ring-glow bg-[var(--glass-bg)] rounded-2xl p-6 shadow-lg border border-[var(--glass-border)] hover:shadow-xl hover:-translate-y-0.5 transition-shadow no-underline"
          >
            <h2 class="text-lg font-bold text-[var(--glass-text)]">{name.zh}</h2>
            {name.en && (
              <span class="text-sm text-[var(--glass-text-muted)] font-mono">{name.en}</span>
            )}
            {
              desc && (
                <p class="text-xs text-[var(--glass-text-secondary)] mt-2 leading-relaxed">
                  <span>{desc.zh}</span>
                  <br />
                  <span class="italic">{desc.en}</span>
                </p>
              )
            }
            <p class="text-sm text-[var(--glass-text-secondary)] mt-2">
              {info.count} 篇文章
            </p>
          </a>
        )
      })
    }
  </div>
</BaseLayout>
