---
import BaseLayout from "../../../layouts/BaseLayout.astro"

const postModules = import.meta.glob(
  "../../../content/categories/**/*.md",
  { eager: true },
) as Record<string, { frontmatter: Record<string, any> }>

// Collect all tags with their post count
const tagCounts: Record<string, number> = {}

for (const mod of Object.values(postModules)) {
  const tags = mod.frontmatter.tags
  if (!Array.isArray(tags)) continue
  for (const tag of tags) {
    if (typeof tag === "string") {
      const key = tag.toLowerCase()
      tagCounts[key] = (tagCounts[key] || 0) + 1
    }
  }
}

// Sort tags by count desc, then alphabetically
const sortedTags = Object.entries(tagCounts).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1]
  return a[0].localeCompare(b[0])
})
---

<BaseLayout title="Tags - Blog">
  <nav class="flex items-center gap-4 text-sm text-gray-400 mb-8">
    <a href="/blog" class="no-underline hover:text-gray-600 transition-colors">
      &larr; 分类
    </a>
  </nav>

  <h1 class="text-3xl font-bold text-gray-900 mb-2">Tags</h1>
  <p class="text-gray-500 mb-8">按标签浏览所有文章</p>

  {
    sortedTags.length > 0 ? (
      <div class="flex flex-wrap gap-3">
        {sortedTags.map(([tag, count]) => (
          <a
            href={`/blog/tags/${tag}`}
            class="inline-flex items-center gap-2 no-underline ring-glow bg-white/25 backdrop-blur-md rounded-xl px-4 py-3 border border-white/30 hover:shadow-md transition-shadow"
          >
            <span class="text-sm font-medium text-gray-700">{tag}</span>
            <span class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5">
              {count}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-gray-400">暂无标签。</p>
    )
  }
</BaseLayout>
