---
import BaseLayout from "../../../layouts/BaseLayout.astro"

const postModules = import.meta.glob(
  "../../../content/categories/**/*.md",
  { eager: true },
) as Record<string, { frontmatter: Record<string, any> }>

// Collect all tags with their post count
const tagCounts: Record<string, number> = {}

for (const mod of Object.values(postModules)) {
  const tags = mod.frontmatter.tags
  if (!Array.isArray(tags)) continue
  for (const tag of tags) {
    if (typeof tag === "string") {
      const key = tag.toLowerCase()
      tagCounts[key] = (tagCounts[key] || 0) + 1
    }
  }
}

// Sort tags by count desc, then alphabetically
const sortedTags = Object.entries(tagCounts).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1]
  return a[0].localeCompare(b[0])
})
---

<BaseLayout title="Tags - Blog">
  <nav class="flex items-center gap-3 mb-6">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm no-underline text-[var(--glass-text-secondary)] bg-[var(--glass-bg-secondary)] shadow-sm rounded-lg px-3 py-1.5 border border-[var(--glass-border)] hover:bg-white/60 hover:text-gray-700 transition-colors"
    >
      &larr; 分类
    </a>
  </nav>

  <h1 class="text-3xl font-bold text-[var(--glass-text)] mb-2">Tags</h1>
  <p class="text-[var(--glass-text-secondary)] mb-8">按标签浏览所有文章</p>

  {
    sortedTags.length > 0 ? (
      <div class="flex flex-wrap gap-3">
        {sortedTags.map(([tag, count]) => (
          <a
            href={`/blog/tags/${tag}`}
            class="inline-flex items-center gap-2 no-underline ring-glow bg-[var(--glass-bg)] rounded-xl px-4 py-3 border border-[var(--glass-border)] hover:shadow-md transition-shadow"
          >
            <span class="text-sm font-medium text-[var(--glass-text)]">{tag}</span>
            <span class="text-xs text-[var(--glass-text-muted)] bg-[var(--glass-bg-secondary)] rounded-full px-2 py-0.5">
              {count}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-[var(--glass-text-muted)]">暂无标签。</p>
    )
  }
</BaseLayout>
