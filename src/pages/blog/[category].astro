---
import BaseLayout from "../../layouts/BaseLayout.astro"
import CategoryDisplay from "../../components/CategoryDisplay.astro"

export async function getStaticPaths() {
  const postModules = import.meta.glob(
    "../../content/categories/**/*.md",
    { eager: true },
  ) as Record<string, unknown>

  const categorySet = new Set<string>()
  for (const filePath of Object.keys(postModules)) {
    const parts = filePath.split("/")
    categorySet.add(parts[parts.indexOf("categories") + 1])
  }

  return Array.from(categorySet).map((cat) => ({
    params: { category: cat },
  }))
}

const { category } = Astro.params

const categoryNames: Record<string, { zh: string; en: string }> = {
  "build-log": { zh: "建站日志", en: "Build Log" },
  blog: { zh: "默认", en: "Blog" },
  projects: { zh: "作品集", en: "Projects" },
  interview: { zh: "面试", en: "Interview" },
  game: { zh: "游戏", en: "Game" },
  music: { zh: "音乐", en: "Music" },
  AI: { zh: "AI", en: "AI" },
}
const display = categoryNames[category] ?? { zh: category, en: "" }

// Get posts for this category
const postModules = import.meta.glob(
  "../../content/categories/**/*.md",
  { eager: true },
) as Record<string, { frontmatter: Record<string, any>; file: string }>

const posts: Array<{
  title: string
  date: string
  slug: string
  description?: string
  tags?: string[]
}> = []

for (const [filePath, mod] of Object.entries(postModules)) {
  const parts = filePath.split("/")
  const cat = parts[parts.indexOf("categories") + 1]
  if (cat !== category) continue

  const filename = parts[parts.length - 1].replace(/\.md$/, "")
  const fm = mod.frontmatter

  posts.push({
    title: fm.title || filename,
    date: fm.date || "",
    slug: filename.toLowerCase().replace(/\s+/g, "-"),
    description: fm.description,
    tags: Array.isArray(fm.tags) ? fm.tags : undefined,
  })
}

posts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())

// Collect all tags across all posts for the sidebar
const allTagCounts: Record<string, number> = {}
for (const mod of Object.values(postModules)) {
  const t = mod.frontmatter.tags
  if (!Array.isArray(t)) continue
  for (const tag of t) {
    if (typeof tag === "string") {
      const key = tag.toLowerCase()
      allTagCounts[key] = (allTagCounts[key] || 0) + 1
    }
  }
}
const allTags = Object.entries(allTagCounts).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1]
  return a[0].localeCompare(b[0])
})
---

<BaseLayout title={`${display.zh} - Blog`}>
  <a
    href="/blog"
    class="inline-flex items-center gap-1.5 text-sm no-underline text-gray-500 bg-gray-100/60 backdrop-blur-sm rounded-lg px-3 py-1.5 border border-gray-200/40 hover:bg-gray-200/60 hover:text-gray-700 transition-colors mb-6"
  >
    &larr; 返回分类
  </a>

  <div class="lg:flex lg:gap-8">
    <!-- 主内容区 -->
    <div class="min-w-0 flex-1">
      <CategoryDisplay
        nameZh={display.zh}
        nameEn={display.en}
        posts={posts}
        basePath={`/blog/${category}`}
      />
    </div>

    <!-- 右侧全站标签栏 -->
    {
      allTags.length > 0 && (
        <aside class="lg:w-44 shrink-0 mt-6 lg:mt-0">
          <div class="lg:sticky lg:top-24">
            <h3 class="text-xs font-semibold text-gray-400 tracking-wider mb-3">
              # 标签
            </h3>
            <div class="flex flex-wrap gap-1.5 lg:flex-col lg:gap-1">
              {allTags.map(([tag, count]) => (
                <a
                  href={`/blog/tags/${tag}`}
                  class="inline-flex items-center justify-between text-xs no-underline bg-white/40 backdrop-blur-sm text-gray-500 rounded-full px-2.5 py-1 border border-white/40 hover:bg-white/60 hover:text-gray-700 transition-colors lg:w-full"
                >
                  <span>{tag}</span>
                  <span class="text-gray-300 ml-1">{count}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>
