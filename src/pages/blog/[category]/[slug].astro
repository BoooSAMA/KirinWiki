---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import ReadingBackdrop from "../../../components/ReadingBackdrop.astro"

export async function getStaticPaths() {
  const modules = import.meta.glob(
    "../../../content/categories/**/*.md",
    { eager: true },
  ) as Record<string, unknown>

  return Object.keys(modules).map((filePath) => {
    const parts = filePath.split("/")
    const category = parts[parts.length - 2]
    const slug = parts[parts.length - 1]
      .replace(/\.md$/, "")
      .toLowerCase()
      .replace(/\s+/g, "-")
    return { params: { category, slug } }
  })
}

const { category, slug } = Astro.params

const categoryNames: Record<string, { zh: string; en: string }> = {
  "build-log": { zh: "建站日志", en: "Build Log" },
  blog: { zh: "默认", en: "Blog" },
  projects: { zh: "作品集", en: "Projects" },
}
const catName = categoryNames[category] ?? { zh: category, en: "" }

// Find the matching .md module
const modules = import.meta.glob(
  "../../../content/categories/**/*.md",
  { eager: true },
) as Record<string, { frontmatter: Record<string, any>; Content: any }>

let fm: Record<string, any> = {}
let ContentComp: any = null

for (const [filePath, mod] of Object.entries(modules)) {
  const parts = filePath.split("/")
  const cat = parts[parts.length - 2]
  const slg = parts[parts.length - 1]
    .replace(/\.md$/, "")
    .toLowerCase()
    .replace(/\s+/g, "-")
  if (cat === category && slg === slug) {
    fm = mod.frontmatter || {}
    ContentComp = mod.Content
    break
  }
}

const postDate = fm.date
  ? (() => {
      const d = new Date(fm.date)
      if (!isNaN(d.getTime()))
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`
      return ""
    })()
  : ""

const tags: string[] = Array.isArray(fm.tags)
  ? fm.tags.filter((t: unknown) => typeof t === "string")
  : []
---

<BaseLayout title={`${fm.title || slug} - ${catName.zh}`}>
  <nav class="flex items-center gap-3 mb-8">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm no-underline text-[var(--glass-text-secondary)] bg-[var(--glass-bg-secondary)] backdrop-blur-sm rounded-lg px-3 py-1.5 border border-gray-200/40 hover:bg-gray-200/60 hover:text-gray-700 transition-colors"
    >
      &larr; 分类
    </a>
    <a
      href={`/blog/${category}`}
      class="inline-flex items-center gap-1.5 text-sm no-underline text-[var(--glass-text-secondary)] bg-[var(--glass-bg-secondary)] backdrop-blur-sm rounded-lg px-3 py-1.5 border border-gray-200/40 hover:bg-gray-200/60 hover:text-gray-700 transition-colors"
    >
      &larr; {catName.zh}
    </a>
  </nav>

  <div class="lg:flex lg:gap-8">
    <!-- 主内容卡片 -->
    <div class="min-w-0 flex-1">
      <ReadingBackdrop>
        <article>
          <header class="mb-8 pb-6 border-b border-gray-200/50">
            <h1 class="text-3xl font-bold text-[var(--glass-text)] mb-2">
              {fm.title || slug}
            </h1>
            {postDate && (
              <time class="text-sm text-[var(--glass-text-muted)]">{postDate}</time>
            )}
            {fm.description && (
              <p class="text-[var(--glass-text-secondary)] mt-3 text-base leading-relaxed">
                {fm.description}
              </p>
            )}
          </header>

          <div class="prose max-w-none">
            {ContentComp ? <ContentComp /> : <p class="text-[var(--glass-text-muted)]">暂无内容。</p>}
          </div>
        </article>
      </ReadingBackdrop>
    </div>

    <!-- 右侧标签栏 -->
    {
      tags.length > 0 && (
        <aside class="lg:w-44 shrink-0 mt-6 lg:mt-0">
          <div class="lg:sticky lg:top-24">
            <h3 class="text-xs font-semibold text-[var(--glass-text-muted)] tracking-wider mb-3">
              # 标签
            </h3>
            <div class="flex flex-wrap gap-1.5 lg:flex-col lg:gap-1">
              {tags.map((tag) => (
                <a
                  href={`/blog/tags/${tag.toLowerCase()}`}
                  class="inline-block text-xs no-underline bg-[var(--glass-bg)] backdrop-blur-sm text-[var(--glass-text-secondary)] rounded-full px-2.5 py-1 border border-[var(--glass-border)] hover:bg-white/60 hover:text-gray-700 transition-colors lg:w-full"
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>
