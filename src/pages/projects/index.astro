---
import BaseLayout from "../../layouts/BaseLayout.astro"
---
<BaseLayout title="Projects">
  <nav class="flex items-center gap-3 mb-6">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm no-underline text-gray-500 bg-gray-100/80 rounded-lg px-3 py-1.5 border border-gray-200/40 hover:bg-gray-200/60 hover:text-gray-700 transition-colors"
    >
      &larr; 返回首页
    </a>
  </nav>

  <h1 class="text-3xl font-bold text-gray-900 mb-2">Projects</h1>
  <p class="text-gray-500 mb-8">Projects not created yet, coming soon.</p>
  <!-- 先放一个占位卡片，后面换成真实项目列表 -->
  <div class="space-y-4">
    <a href="/projects/first-project" class="block ring-glow bg-white/85 rounded-2xl p-6 shadow-lg border border-white/30 hover:shadow-xl transition-shadow no-underline">
      <h2 class="text-lg font-medium text-gray-900 mt-1">还没有项目</h2>
      <p class="text-gray-500 text-sm mt-1">第一个项目正在路上……</p>
    </a>
  </div>
</BaseLayout>