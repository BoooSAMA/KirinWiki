---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout title="About Me">
  <nav class="flex items-center gap-3 mb-6">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm no-underline text-[var(--glass-text-secondary)] bg-[var(--glass-bg-secondary)] rounded-lg px-3 py-1.5 border border-[var(--glass-border)] hover:bg-white/60 hover:text-gray-700 transition-colors"
    >
      &larr; 返回首页
    </a>
  </nav>

  <h1 class="text-3xl font-bold text-[var(--glass-text)] mb-2">About Me</h1>
  <p class="text-[var(--glass-text-secondary)] mb-8">This is the about page. More content coming soon.</p>
  <!-- 先放一个占位内容，后面换成真实的个人介绍 -->
  <div class="ring-glow bg-[var(--glass-bg)] rounded-2xl p-6 shadow-lg border border-[var(--glass-border)]">
    <h2 class="text-lg font-medium text-[var(--glass-text)] mt-1">Hello, I'm Kirin!</h2>
    <p class="text-[var(--glass-text-secondary)] text-sm mt-1">I'm a tech enthusiast who loves blogging about technology and sharing my projects. Stay tuned for more updates!</p>
  </div>
</BaseLayout>