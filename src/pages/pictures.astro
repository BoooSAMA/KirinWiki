---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout title="Pictures">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Shares</h1>
  <p class="text-gray-500 mb-8">Here are some useful resources and links that I want to share with you.</p>
  <!-- 先放一个占位内容，后面换成真实的分享列表 -->
  <div class="space-y-4">
    <a href="/shares/first-share" class="block ring-glow bg-white/60 backdrop-blur-md rounded-2xl p-6 shadow-lg border border-white/30 hover:shadow-xl transition-shadow no-underline">
      <h2 class="text-lg font-medium text-gray-900 mt-1">还没有分享</h2>
      <p class="text-gray-500 text-sm mt-1">第一个分享正在路上……</p>
    </a>
  </div>
</BaseLayout>