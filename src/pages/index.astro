---
import BaseLayout from "../layouts/BaseLayout.astro"
import LikeButton from "../components/LikeButton"
---
<BaseLayout title="Homepage">

  <!-- 首页欢迎语和简介 -->
  <section class="text-center mb-16 pt-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to KirinWiki</h1>
    <p class="text-lg text-gray-500 max-w-lg mx-auto">
      A personal blog about technology, projects
    </p>
  </section>

  <!-- 首页主要内容区域，使用网格布局展示不同的板块 -->
  <section class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    {
      [
        { href: "/blog", emoji:"📝", label: " Blog", desc: "Read my latest blog posts" },
        { href: "/projects", emoji:"💼", label: "Projects", desc: "Check out my recent projects" },
        { href: "/pictures", emoji:"🖼️", label: "Pictures", desc: "View my photo collection" },
        { href: "/shares", emoji:"🔗", label: "Shares", desc: "Find useful resources and links" },
        { href: "/about", emoji:"👤", label: "About", desc: "Learn more about me" },
      ].map(({ href, emoji, label, desc }) => (
         <a
        href={href}
        class="block ring-glow bg-white/25 backdrop-blur-md rounded-3xl p-6 shadow-lg border border-white/30
               hover:shadow-xl hover:-translate-y-1 transition-all duration-200
               no-underline text-center"
          >
            <div class="text-3xl mb-2">{emoji}</div>
            <div class="font-medium text-gray-900">{label}</div>
            <div class="text-sm text-gray-400 mt-1">{desc}</div>
        </a>
      ))
    }
  </section>

  <!-- 首页底部的社交链接 -->
  <section class="mt-16 text-center">
    <div class="flex items-center justify-center gap-5">
      <!-- GitHub -->
      <a
        href="https://github.com/BoooSAMA"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-500 hover:text-gray-900 transition-colors"
        title="GitHub"
      >
        <svg class="w-6 h-6" viewBox="0 0 98 96" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.362 19.412-6.518 33.405-24.934 33.405-46.69C97.707 22 75.788 0 48.854 0z"/>
        </svg>
      </a>
      <!-- Email（点击复制到剪贴板） -->
      <button
        id="copy-email-btn"
        class="relative text-gray-500 hover:text-gray-900 transition-colors cursor-pointer"
        title="点击复制邮箱"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <span id="copy-toast" class="absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-gray-800 px-2.5 py-1 text-xs text-white opacity-0 transition-opacity pointer-events-none">
          已复制！
        </span>
      </button>
    </div>
  </section>

  <!-- Like button -->
  <div class="mt-8 flex justify-center">
    <LikeButton slug="homepage" client:load />
  </div>

  <script>
    const copyBtn = document.getElementById('copy-email-btn');
    const toast = document.getElementById('copy-toast');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('booosama0113@gmail.com');
        toast?.classList.add('opacity-100');
        setTimeout(() => toast?.classList.remove('opacity-100'), 1500);
      } catch {
        // 降级：打开默认邮件客户端
        window.location.href = 'mailto:booosama0113@gmail.com';
      }
    });
  </script>
</BaseLayout>