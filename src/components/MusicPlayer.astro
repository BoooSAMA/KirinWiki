---
// MusicPlayer.astro — 固定底部播放器，View Transitions 切换页面时不断播
// 歌单从 /music/playlist.json 动态加载（由 scripts/sync_music.py 生成）
---
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css" />

<!-- data-astro-transition-persist 让这个元素在页面切换时不被销毁 -->
<div id="aplayer" data-astro-transition-persist></div>

<script is:inline src="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js"></script>

<script>
  if (!window.__aplayerInit) {
    window.__aplayerInit = true;

    let ap = null;
    let restoreIndex = -1;
    let restoreTime = 0;
    let restorePlaying = false;

    // 读取上次播放状态
    try {
      const raw = localStorage.getItem('aplayer-state');
      if (raw) {
        const s = JSON.parse(raw);
        restoreIndex = s.index ?? -1;
        restoreTime = s.currentTime ?? 0;
        restorePlaying = !s.paused;
      }
    } catch {}

    // 加载歌单并初始化
    fetch('/music/playlist.json?' + Date.now()) // cache bust
      .then((r) => {
        if (!r.ok) throw new Error('歌单未找到');
        return r.json();
      })
      .then((playlist) => {
        if (!playlist || playlist.length === 0) return;

        ap = new APlayer({
          container: document.getElementById('aplayer'),
          fixed: true,
          order: 'list',
          audio: playlist,
          loop: 'all',
          preload: 'none',
          volume: 0.7,
          listFolded: true,
        });

        window.__ap = ap;

        // 恢复播放进度
        if (restoreIndex >= 0 && restoreIndex < playlist.length) {
          ap.list.switch(restoreIndex);
          setTimeout(() => {
            ap.seek(restoreTime);
            if (restorePlaying) ap.play();
          }, 1000);
        }

        // 保存播放状态
        function saveState() {
          try {
            localStorage.setItem(
              'aplayer-state',
              JSON.stringify({
                index: ap.list.index,
                currentTime: ap.audio.currentTime,
                paused: ap.paused,
                volume: ap.audio.volume,
              })
            );
          } catch {}
        }

        document.addEventListener('astro:before-swap', saveState);
        window.addEventListener('beforeunload', saveState);
      })
      .catch(() => {
        // 歌单不存在，静默不显示播放器
      });
  }
</script>
