---
// MusicPlayer.astro — 自建播放器，深色毛玻璃 + 彩灯边框
// 音频与 UI 分离：audio 永不销毁，UI 每次导航重新渲染
// 歌单: /music/playlist.json（本地）/playlist.r2.json（生产自动转 R2 URL）
---

<!-- 持久化容器（空壳，内容由 JS 填充） -->
<audio id="player-audio" data-astro-transition-persist="audio" preload="none" style="display:none"></audio>
<div id="player-floating" data-astro-transition-persist="floating"></div>
<style is:global>
/* ─── 浮动容器 ─── */
#player-floating {
  position: fixed;
  bottom: 20px;
  left: 20px;
  width: 280px;
  z-index: 2147483647;
  display: flex;
  flex-direction: column;
  gap: 6px;
  transform: scale(1.2);
  transform-origin: bottom left;
}
#player-panel {
  max-height: 0; opacity: 0; overflow: hidden;
  transition: max-height 0.38s cubic-bezier(0.4,0,0.2,1), opacity 0.3s ease;
  border-radius: 14px;
  background: rgba(8,8,20,0.92);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.07);
}
#player-panel.open { max-height: 380px; opacity: 1; }
.panel-inner { padding: 8px 6px; overflow-y: auto; max-height: 360px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.12) transparent; }
.panel-inner::-webkit-scrollbar { width: 4px; }
.panel-inner::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 2px; }
.panel-empty { padding: 20px; text-align: center; color: rgba(255,255,255,0.4); font-size: 13px; }
.tree-artist { margin-bottom: 2px; }
.tree-artist-label, .tree-album-label { display: flex; align-items: center; gap: 5px; padding: 5px 8px; border-radius: 8px; cursor: pointer; transition: background 0.12s; user-select: none; }
.tree-artist-label:hover, .tree-album-label:hover { background: rgba(255,255,255,0.05); }
.tree-artist-label { font-size: 13.5px; font-weight: 600; color: rgba(255,255,255,0.92); }
.tree-album-label { padding-left: 24px; font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.7); }
.tree-icon { font-size: 10px; color: rgba(255,255,255,0.35); flex-shrink: 0; width: 14px; text-align: center; }
.tree-children { overflow: hidden; max-height: 0; transition: max-height 0.28s cubic-bezier(0.4,0,0.2,1); }
.tree-children.open { max-height: 2000px; }
.tree-song { display: flex; align-items: center; gap: 5px; padding: 4px 8px 4px 44px; font-size: 12.5px; color: rgba(255,255,255,0.55); cursor: pointer; border-radius: 6px; transition: background 0.12s, color 0.12s; }
.tree-song:hover { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.75); }
.tree-song.active { color: #818cf8; background: rgba(129,140,248,0.1); }
.tree-song-icon { font-size: 10px; flex-shrink: 0; width: 14px; text-align: center; }
.album-play { font-size: 10px; color: rgba(255,255,255,0.3); cursor: pointer; transition: color 0.15s; padding: 2px; border-radius: 4px; }
.album-play:hover { color: #818cf8; background: rgba(129,140,248,0.12); }

/* ─── 播放栏 ─── */
#player-bar { position: relative; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.35), 0 2px 8px rgba(0,0,0,0.2); }
.bar-border { position: absolute; inset: 0; background: linear-gradient(90deg,#ff0080,#ff4400,#ffcc00,#00d4aa,#0066ff,#7c3aed,#ff0080); background-size: 300% 100%; animation: border-slide 12s linear infinite; animation-play-state: paused; will-change: background-position; }
.bar-border.active { animation-play-state: running; }
@keyframes border-slide { to { background-position: 300% 0; } }
.bar-content { position: relative; margin: 2px; background: rgba(10,10,24,0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-radius: 12px; padding: 10px 12px 8px; display: flex; flex-direction: column; gap: 5px; z-index: 1; }

/* ─── 控制按钮 ─── */
.ctrl-btn { background: none; border: none; color: rgba(255,255,255,0.75); font-size: 16px; cursor: pointer; padding: 4px 6px; border-radius: 6px; transition: background 0.12s, color 0.12s, transform 0.1s; line-height: 1; flex-shrink: 0; }
.ctrl-btn:hover { background: rgba(255,255,255,0.08); color: #fff; }
.ctrl-btn:active { transform: scale(0.92); }
.ctrl-btn.sm { font-size: 14px; padding: 4px 5px; }
#btn-play { font-size: 20px; padding: 4px 8px; }
#btn-prev, #btn-next { font-size: 22px; }
#btn-list { font-size: 26px; }
#btn-vol { font-size: 17px; }

/* ─── 布局 ─── */
.br-top { display: flex; align-items: center; justify-content: space-between; }
.br-top-right { display: flex; align-items: center; gap: 4px; }
.vol-horiz { display: flex; align-items: center; gap: 3px; }
.vol-slider-horiz { -webkit-appearance: none; appearance: none; width: 70px; height: 5px; background: rgba(255,255,255,0.12); border-radius: 3px; outline: none; cursor: pointer; }
.vol-slider-horiz::-webkit-slider-thumb { -webkit-appearance: none; width: 13px; height: 13px; border-radius: 50%; background: #818cf8; cursor: pointer; border: none; }
.vol-slider-horiz::-moz-range-thumb { width: 13px; height: 13px; border-radius: 50%; background: #818cf8; cursor: pointer; border: none; }
.br-sep { height: 1px; background: rgba(255,255,255,0.05); }
.br-mid { display: flex; align-items: center; gap: 8px; }
.bar-info { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; }
.bar-title { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.92); overflow: hidden; text-overflow: ellipsis; }
.bar-artist { font-size: 11px; color: rgba(255,255,255,0.45); overflow: hidden; text-overflow: ellipsis; }
.br-bot { display: flex; align-items: center; gap: 6px; }
#bar-progress { -webkit-appearance: none; appearance: none; flex: 1; height: 4px; background: rgba(255,255,255,0.15); border-radius: 2px; outline: none; cursor: pointer; transition: height 0.15s; }
#bar-progress:hover { height: 6px; }
#bar-progress::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg,#818cf8,#6366f1); cursor: pointer; border: 2px solid rgba(255,255,255,0.25); box-shadow: 0 0 12px rgba(129,140,248,0.35); opacity: 0; transition: opacity 0.15s; }
#bar-progress:hover::-webkit-slider-thumb { opacity: 1; }
#bar-progress::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg,#818cf8,#6366f1); cursor: pointer; border: 2px solid rgba(255,255,255,0.25); }
#br-time-row { display: flex; justify-content: center; }
.bar-time { font-size: 11px; color: rgba(255,255,255,0.4); font-variant-numeric: tabular-nums; }

/* ─── 迷你播放器（收起状态） ─── */
#mini-player {
  display: none;
  align-items: center;
  gap: 4px;
  padding: 4px 4px;
}
.mini-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border: none;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  cursor: pointer;
  color: rgba(255,255,255,0.8);
  font-size: 17px;
  transition: background 0.15s, color 0.15s;
}
.mini-btn:hover {
  background: rgba(129,140,248,0.2);
  color: #818cf8;
}
.mini-btn svg { display: block; }

/* ─── 收起展开动画 ─── */
#player-bar.collapsing,
#player-panel.collapsing {
  transition: transform 0.35s ease, opacity 0.3s ease !important;
  transform-origin: bottom left !important;
  pointer-events: none !important;
}
</style>

<script>
(function() {
  /* ===== 去重：只清理多余的持久化元素，保留第一个 ===== */
  function dedupePersist(id) {
    const all = document.querySelectorAll(`#${CSS.escape(id)}`);
    for (let i = 1; i < all.length; i++) all[i].remove();
  }
  dedupePersist('player-audio');
  dedupePersist('player-floating');

  /* ===== 页面切换时：如果 player 已存在，只更新 UI ===== */
  if (window.__playerReady) {
    if (window.__player) {
      if (typeof renderTree === 'function') renderTree();
      if (typeof updateBarDisplay === 'function') updateBarDisplay();
      if (typeof updateProgressBar === 'function') updateProgressBar();
    }
    return;
  }
  window.__playerReady = true;

  /* ===== 首次加载：填充持久化容器 ===== */
  const audio = document.getElementById('player-audio');
  const floating = document.getElementById('player-floating');

  /* ===== SVG 图标 ===== */
  const I = {
    play: '<svg viewBox="0 0 20 20" width="1em" height="1em"><path d="M5 3l12 7-12 7V3z" fill="currentColor"/></svg>',
    pause: '<svg viewBox="0 0 20 20" width="1em" height="1em"><rect x="5" y="3" width="3" height="14" rx="1" fill="currentColor"/><rect x="12" y="3" width="3" height="14" rx="1" fill="currentColor"/></svg>',
    prev: '<svg viewBox="0 0 20 20" width="1em" height="1em"><path d="M4 4v12h2.5V4H4zm5.5 6l7-6v12l-7-6z" fill="currentColor"/></svg>',
    next: '<svg viewBox="0 0 20 20" width="1em" height="1em"><path d="M4 16l7-6-7-6v12zm8.5-12v12H15V4h-2.5z" fill="currentColor"/></svg>',
    vol: '<svg viewBox="0 0 20 20" width="1em" height="1em"><path d="M2 7v6h3.5l4.5 4V3L5.5 7H2zm7 0v6a3.5 3.5 0 000-6z" fill="currentColor"/><path d="M12.5 10a2.5 2.5 0 00-2-2.45v4.9A2.5 2.5 0 0012.5 10z" fill="currentColor"/></svg>',
    volLow: '<svg viewBox="0 0 20 20" width="1em" height="1em"><path d="M2 7v6h3.5l4.5 4V3L5.5 7H2zm4.5 0v6a2 2 0 000-6z" fill="currentColor"/></svg>',
    volMuted: '<svg viewBox="0 0 20 20" width="1em" height="1em"><path d="M2 7v6h3.5l4.5 4V3L5.5 7H2zm8.5 3l-2 2m0-4l2 2" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>',
    menu: '<svg viewBox="0 0 20 20" width="1em" height="1em"><rect x="2" y="4" width="16" height="2" rx="1" fill="currentColor"/><rect x="2" y="9" width="16" height="2" rx="1" fill="currentColor"/><rect x="2" y="14" width="16" height="2" rx="1" fill="currentColor"/></svg>',
    close: '<svg viewBox="0 0 20 20" width="1em" height="1em"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>',
  };

  /* ===== 构建 UI ===== */
  floating.innerHTML = `
    <div id="player-panel">
      <div class="panel-inner">
        <div id="panel-tree"></div>
        <div id="panel-empty" class="panel-empty hidden">歌单加载中…</div>
      </div>
    </div>
    <div id="player-bar">
      <div id="bar-border" class="bar-border"></div>
      <div class="bar-content">
        <div class="br-top">
          <div class="vol-horiz">
            <button id="btn-vol" class="ctrl-btn sm" title="音量">${I.vol}</button>
            <input type="range" id="vol-slider" min="0" max="100" value="70" class="vol-slider-horiz">
          </div>
          <div class="br-top-right">
            <button id="btn-prev" class="ctrl-btn sm" title="上一首">${I.prev}</button>
            <button id="btn-next" class="ctrl-btn sm" title="下一首">${I.next}</button>
            <button id="btn-list" class="ctrl-btn" title="歌单">${I.menu}</button>
            <button id="btn-collapse" class="ctrl-btn sm" title="收起播放器">▾</button>
          </div>
        </div>
        <div class="br-sep"></div>
        <div class="br-mid">
          <button id="btn-play" class="ctrl-btn" title="播放/暂停">${I.play}</button>
          <div class="bar-info">
            <div id="bar-title" class="bar-title">未在播放</div>
            <div id="bar-artist" class="bar-artist">—</div>
          </div>
        </div>
        <div class="br-bot">
          <input type="range" id="bar-progress" min="0" max="1000" value="0" step="1">
        </div>
        <div id="br-time-row">
          <span id="bar-time" class="bar-time">0:00</span>
        </div>
      </div>
    </div>
    <div id="mini-player">
      <button class="mini-btn" id="mini-play-btn">${I.play}</button>
      <button class="mini-btn" id="mini-expand-btn">▲</button>
    </div>
  `;

  /* ===== DOM 引用 ===== */
  const $ = id => document.getElementById(id);
  const btnPlay = $('btn-play');
  const btnPrev = $('btn-prev');
  const btnNext = $('btn-next');
  const btnVol  = $('btn-vol');
  const btnList = $('btn-list');
  const progress = $('bar-progress');
  const volSlider = $('vol-slider');
  const barTime  = $('bar-time');
  const barTitle = $('bar-title');
  const barArtist = $('bar-artist');
  const panel = $('player-panel');
  const treeEl = $('panel-tree');
  const emptyEl = $('panel-empty');
  const borderEl = $('bar-border');
  const btnCollapse = $('btn-collapse');
  const miniPlayBtn = $('mini-play-btn');

  /* ===== 工具函数 ===== */
  function escapeHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function formatTime(t) {
    if (!t || isNaN(t) || !isFinite(t)) return '0:00';
    const h = Math.floor(t / 3600);
    const m = Math.floor((t % 3600) / 60);
    const s = Math.floor(t % 60);
    if (h > 0) return `${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    return `${m}:${String(s).padStart(2,'0')}`;
  }

  /* ===== 构建树 ===== */
  function buildTree(songs) {
    const raw = {};
    for (const s of songs) {
      const a = s.artist || '未知';
      const al = s.album || '未知';
      if (!raw[a]) raw[a] = {};
      if (!raw[a][al]) raw[a][al] = [];
      raw[a][al].push(s);
    }
    const sorted = {};
    for (const artist of Object.keys(raw).sort((a,b) => a.localeCompare(b, 'zh'))) {
      sorted[artist] = {};
      for (const album of Object.keys(raw[artist]).sort((a,b) => a.localeCompare(b, 'zh'))) {
        sorted[artist][album] = raw[artist][album];
      }
    }
    return sorted;
  }

  /* ===== 渲染树 ===== */
  function renderTree() {
    const st = window.__player;
    if (!st || !st.tree) return;
    let html = '';
    const currentUrl = st.currentUrl;
    const exp = st.expanded || {};
    for (const [artist, albums] of Object.entries(st.tree)) {
      const aKey = artist;
      const aOpen = exp[aKey];
      html += `<div class="tree-artist"><div class="tree-artist-label" data-action="toggle-artist" data-key="${escapeHtml(aKey)}"><span class="tree-icon">${aOpen ? '▾' : '▸'}</span>${escapeHtml(artist)}</div><div class="tree-children${aOpen ? ' open' : ''}">`;
      for (const [album, songs] of Object.entries(albums)) {
        const alKey = aKey + '||' + album;
        const alOpen = exp[alKey];
        html += `<div class="tree-album"><div class="tree-album-label" data-action="toggle-album" data-key="${escapeHtml(alKey)}"><span class="tree-icon">${alOpen ? '▾' : '▸'}</span><span class="album-play" data-action="play-album" data-artist="${escapeHtml(artist)}" data-album="${escapeHtml(album)}" title="播放整张专辑">▶</span>${escapeHtml(album)}</div><div class="tree-children${alOpen ? ' open' : ''}">`;
        for (const song of songs) {
          const isActive = song.url === currentUrl;
          html += `<div class="tree-song${isActive ? ' active' : ''}" data-action="play-song" data-url="${escapeHtml(song.url)}"><span class="tree-song-icon">${isActive ? '🔊' : '♪'}</span>${escapeHtml(song.name)}</div>`;
        }
        html += `</div></div>`;
      }
      html += `</div></div>`;
    }
    treeEl.innerHTML = html;
    panel.classList.toggle('open', st.panelOpen);
  }

  /* ===== 更新 UI ===== */
  function updateBarDisplay() {
    const st = window.__player;
    if (!st) return;
    const idx = st.queueIndex;
    if (idx >= 0 && idx < st.queue.length) {
      const url = st.queue[idx];
      const song = st.songs.find(s => s.url === url);
      if (song) {
        barTitle.textContent = song.name;
        barArtist.textContent = song.artist;
        btnPlay.innerHTML = st.isPlaying ? I.pause : I.play;
        if (miniPlayBtn) miniPlayBtn.innerHTML = st.isPlaying ? I.pause : I.play;
        return;
      }
    }
    barTitle.textContent = '未在播放';
    barArtist.textContent = '—';
    btnPlay.innerHTML = I.play;
    if (miniPlayBtn) miniPlayBtn.innerHTML = I.play;
  }

  function updateProgressBar() {
    const st = window.__player;
    if (!st || !st.audio) return;
    const a = st.audio;
    if (!a.duration || !a.currentTime) {
      progress.value = 0;
      barTime.textContent = '0:00';
      progress.style.background = 'rgba(255,255,255,0.15)';
      return;
    }
    const pct = (a.currentTime / a.duration) * 100;
    progress.value = Math.round(Math.min(pct * 10, 1000));
    barTime.textContent = formatTime(a.currentTime);
    progress.style.background = `linear-gradient(to right, #818cf8 ${pct}%, rgba(255,255,255,0.12) ${pct}%)`;
  }

  /* ===== 状态 ===== */
  const state = {
    audio,
    songs: [],
    tree: {},
    queue: [],
    queueIndex: -1,
    currentUrl: null,
    isPlaying: false,
    panelOpen: false,
    expanded: {},
  };
  window.__player = state;

  /* ===== 加载歌单 ===== */
  async function loadPlaylist() {
    const ts = Date.now();
    let res = await fetch('/music/playlist.json?' + ts);
    if (!res.ok) {
      res = await fetch('/music/playlist.r2.json?' + ts);
    }
    if (!res.ok) throw new Error('歌单加载失败');
    return res.json();
  }

  loadPlaylist().then(songs => {
    if (!songs || songs.length === 0) return;

    // 生产环境将本地 URL 转 R2 URL
    const isProd = import.meta.env.PROD;
    if (isProd) {
      const r2Base = 'https://music.myproxy2.cc.cd/';
      for (const s of songs) {
        if (s.url && s.url.startsWith('/music/audio/')) {
          s.url = r2Base + s.url.slice('/music/audio/'.length);
        }
      }
    }

    state.songs = songs;
    state.tree = buildTree(songs);

    audio.ontimeupdate = () => updateProgressBar();
    audio.onloadedmetadata = () => updateProgressBar();
    audio.onended = () => { nextSong(); };
    audio.onerror = () => { setTimeout(nextSong, 1000); };
    audio.onplay = () => { if (borderEl) borderEl.classList.add('active'); };
    audio.onpause = () => { if (borderEl) borderEl.classList.remove('active'); };

    // 恢复状态
    let saved = null;
    try {
      const raw = localStorage.getItem('player-state');
      if (raw) saved = JSON.parse(raw);
    } catch {}

    if (saved && saved.volume != null) {
      audio.volume = saved.volume;
      volSlider.value = saved.volume * 100;
    }

    if (saved && saved.url) {
      const idx = songs.findIndex(s => s.url === saved.url);
      if (idx >= 0) {
        state.queue = [saved.url];
        state.queueIndex = 0;
        state.currentUrl = saved.url;
        audio.src = saved.url;
        audio.currentTime = saved.currentTime || 0;
        if (!saved.paused) {
          audio.play().catch(() => {});
          state.isPlaying = true;
        }
      }
    }

    renderTree();
    updateBarDisplay();
    if (emptyEl) emptyEl.classList.add('hidden');

    // 持久化
    function persist() {
      try {
        localStorage.setItem('player-state', JSON.stringify({
          url: state.currentUrl,
          currentTime: audio.currentTime,
          paused: audio.paused,
          volume: audio.volume,
          queue: state.queue,
          queueIndex: state.queueIndex,
        }));
        localStorage.setItem('player-ui', JSON.stringify({
          expanded: state.expanded,
          panelOpen: state.panelOpen,
        }));
      } catch {}
    }

    document.addEventListener('astro:before-swap', persist);
    window.addEventListener('beforeunload', persist);

    // 恢复 UI 状态
    try {
      const uiRaw = localStorage.getItem('player-ui');
      if (uiRaw) {
        const ui = JSON.parse(uiRaw);
        if (ui.expanded) state.expanded = ui.expanded;
        if (ui.panelOpen) {
          state.panelOpen = true;
          panel.classList.add('open');
        }
      }
    } catch {}

    // 自动展开当前歌路径
    if (state.currentUrl) {
      const song = songs.find(s => s.url === state.currentUrl);
      if (song) {
        state.expanded[song.artist] = true;
        state.expanded[song.artist + '||' + song.album] = true;
        renderTree();
      }
    }

    // 恢复收起状态
    try {
      if (localStorage.getItem('player-collapsed') === 'true') {
        const barEl = $('player-bar');
        const pnl = $('player-panel');
        const mini = $('mini-player');
        if (barEl) barEl.style.display = 'none';
        if (pnl) pnl.style.display = 'none';
        if (mini) {
          mini.style.display = 'flex';
          syncMiniPlayBtn();
        }
      }
    } catch {}
  }).catch(e => {
    if (emptyEl) {
      emptyEl.textContent = '歌单加载失败';
      emptyEl.classList.remove('hidden');
    }
  });

  /* ===== 播放控制 ===== */
  function playUrl(url) {
    audio.src = url;
    audio.currentTime = 0;
    audio.play().catch(() => {});
    state.currentUrl = url;
    state.isPlaying = true;
    updateBarDisplay();
    renderTree();
  }

  function playSong(url) {
    state.queue = [url];
    state.queueIndex = 0;
    playUrl(url);
  }

  function playAlbum(artist, album) {
    const songs = state.tree[artist]?.[album];
    if (!songs || songs.length === 0) return;
    state.queue = songs.map(s => s.url);
    state.queueIndex = 0;
    playUrl(songs[0].url);
  }

  function nextSong() {
    if (state.queue.length === 0) return;
    state.queueIndex = (state.queueIndex + 1) % state.queue.length;
    playUrl(state.queue[state.queueIndex]);
  }

  function prevSong() {
    if (audio.currentTime > 3) {
      audio.currentTime = 0;
      return;
    }
    if (state.queue.length === 0) return;
    state.queueIndex = (state.queueIndex - 1 + state.queue.length) % state.queue.length;
    playUrl(state.queue[state.queueIndex]);
  }

  /* ===== 收起/展开 ===== */
  function collapsePlayer() {
    const barEl = $('player-bar');
    const pnl = $('player-panel');
    const mini = $('mini-player');
    if (!barEl || !pnl || !mini) return;

    barEl.classList.add('collapsing');
    pnl.classList.add('collapsing');
    barEl.style.transform = 'scale(0.08)';
    barEl.style.opacity = '0';
    pnl.style.transform = 'scale(0.08)';
    pnl.style.opacity = '0';

    setTimeout(() => {
      barEl.style.display = 'none';
      pnl.style.display = 'none';
      barEl.classList.remove('collapsing');
      pnl.classList.remove('collapsing');
      barEl.style.transform = '';
      barEl.style.opacity = '';
      pnl.style.transform = '';
      pnl.style.opacity = '';
      mini.style.display = 'flex';
      syncMiniPlayBtn();
    }, 350);

    try { localStorage.setItem('player-collapsed', 'true'); } catch {}
  }

  function expandPlayer() {
    const barEl = $('player-bar');
    const pnl = $('player-panel');
    const mini = $('mini-player');
    if (!barEl || !pnl || !mini) return;

    mini.style.display = 'none';
    barEl.style.display = '';
    pnl.style.display = '';

    barEl.classList.add('collapsing');
    pnl.classList.add('collapsing');
    barEl.style.transform = 'scale(0.08)';
    barEl.style.opacity = '0';
    pnl.style.transform = 'scale(0.08)';
    pnl.style.opacity = '0';
    void barEl.offsetHeight;

    barEl.style.transform = 'scale(1)';
    barEl.style.opacity = '1';
    pnl.style.transform = 'scale(1)';
    pnl.style.opacity = '1';

    setTimeout(() => {
      barEl.classList.remove('collapsing');
      pnl.classList.remove('collapsing');
      barEl.style.transform = '';
      barEl.style.opacity = '';
      pnl.style.transform = '';
      pnl.style.opacity = '';
    }, 350);

    try { localStorage.setItem('player-collapsed', 'false'); } catch {}
  }

  function syncMiniPlayBtn() {
    if (!miniPlayBtn) return;
    miniPlayBtn.innerHTML = state.isPlaying ? I.pause : I.play;
  }

  /* ===== 事件绑定 ===== */
  btnPlay.addEventListener('click', () => {
    if (!audio.src) {
      if (state.songs.length > 0) playSong(state.songs[0].url);
      return;
    }
    if (audio.paused) {
      audio.play().catch(() => {});
      state.isPlaying = true;
    } else {
      audio.pause();
      state.isPlaying = false;
    }
    updateBarDisplay();
  });

  btnPrev.addEventListener('click', prevSong);
  btnNext.addEventListener('click', nextSong);

  volSlider.addEventListener('input', () => {
    const v = volSlider.value / 100;
    audio.volume = v;
    btnVol.innerHTML = v === 0 ? I.volMuted : v < 0.3 ? I.volLow : I.vol;
  });
  btnVol.addEventListener('click', () => {
    audio.muted = !audio.muted;
    btnVol.innerHTML = audio.muted ? I.volMuted : I.vol;
  });

  btnList.addEventListener('click', (e) => {
    e.stopPropagation();
    state.panelOpen = !state.panelOpen;
    panel.classList.toggle('open', state.panelOpen);
    btnList.innerHTML = state.panelOpen ? I.close : I.menu;
    if (state.panelOpen) {
      renderTree();
      document.addEventListener('click', closePanelOutside);
    } else {
      document.removeEventListener('click', closePanelOutside);
    }
  });

  function closePanelOutside(e) {
    const pf = document.getElementById('player-floating');
    if (pf && !pf.contains(e.target)) {
      state.panelOpen = false;
      panel.classList.remove('open');
      btnList.innerHTML = I.menu;
      document.removeEventListener('click', closePanelOutside);
    }
  }

  btnCollapse.addEventListener('click', collapsePlayer);
  $('mini-play-btn')?.addEventListener('click', () => { btnPlay.click(); });
  $('mini-expand-btn')?.addEventListener('click', expandPlayer);

  progress.addEventListener('input', () => {
    if (!audio.duration) return;
    audio.currentTime = (progress.value / 1000) * audio.duration;
  });

  treeEl.addEventListener('click', (e) => {
    const target = e.target.closest('[data-action]');
    if (!target) return;
    e.stopPropagation();
    const action = target.dataset.action;
    if (action === 'toggle-artist') {
      state.expanded[target.dataset.key] = !state.expanded[target.dataset.key];
      renderTree();
    } else if (action === 'toggle-album') {
      state.expanded[target.dataset.key] = !state.expanded[target.dataset.key];
      renderTree();
    } else if (action === 'play-song') {
      playSong(target.dataset.url);
    } else if (action === 'play-album') {
      playAlbum(target.dataset.artist, target.dataset.album);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.code === 'Space') {
      e.preventDefault();
      btnPlay.click();
    }
  });

  updateBarDisplay();
})();
</script>
