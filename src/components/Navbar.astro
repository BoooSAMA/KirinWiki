---
// 导航链接列表
const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
  { href: "/pictures", label: "Pictures" },
  { href: "/shares", label: "Shares" },
  { href: "/about", label: "About" },
]
---
<nav>
  <ul>
    {links.map(link => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>