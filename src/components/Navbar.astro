---
// 导航链接列表
const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
  { href: "/pictures", label: "Pictures" },
  { href: "/shares", label: "Shares" },
  { href: "/about", label: "About" },
]
const currentPath = Astro.url.pathname
---
<header class="border-b border-[var(--glass-border)] bg-[var(--glass-bg)] backdrop-blur-sm glass-blur sticky top-0 z-50"> <!-- 半透明背景和模糊效果，固定在顶部 -->
  <nav class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between"> <!-- 导航内容自动居中，左右有内边距，使用 Flexbox 布局 -->
    <a href="/" class="text-lg font-bold text-[var(--glass-text)] no-underline"> <!-- 网站名称，使用较大字体和加粗，去掉默认下划线 -->
      KirinWiki
    </a> <!-- 导航链接，去掉默认下划线，悬停时变色，当前页面加粗 -->
    <ul class="flex gap-6 text-sm">
      {links.map(link => (
        <li>
           <a href={link.href} class={'no-underline hover:text-[var(--glass-text)] transition-colors ${currentPath === link.href ? "text-[var(--glass-text)] font-medium" : "text-[var(--glass-text-secondary)]" }'}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>