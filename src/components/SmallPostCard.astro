---
export interface Props {
  title: string
  date: string
  href: string
  description?: string
}

const { title, date, href, description } = Astro.props
---

<a
  href={href}
  class="block ring-glow bg-[var(--glass-bg)] backdrop-blur-md rounded-xl p-4 shadow-md border border-[var(--glass-border)] hover:shadow-lg transition-shadow no-underline min-w-0"
>
  {date && <time class="text-xs text-[var(--glass-text-muted)]">{date}</time>}
  <h3 class="text-sm font-medium text-[var(--glass-text)] mt-1 leading-snug line-clamp-2">{title}</h3>
  {description && (
    <p class="text-xs text-[var(--glass-text-secondary)] mt-1 line-clamp-2">{description}</p>
  )}
</a>
