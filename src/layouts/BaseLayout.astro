---
import "../styles/global.css"
import Navbar from "../components/Navbar.astro"
import MusicPlayer from "../components/MusicPlayer.astro"
import ClientRouter from "astro/components/ClientRouter.astro"
const { title } = Astro.props
---
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body class="text-gray-800 min-h-screen font-sans">
    <div id="bg3d" data-astro-transition-persist="bg3d" style="position:fixed;inset:0;z-index:0;pointer-events:none"></div>
    <Navbar />
    <main class="max-w-4xl mx-auto px-6 py-12">
      <slot />
    </main>
    <MusicPlayer />
  </body>
</html>

<script>
import { createScene } from '../lib/crystalScene'

const root = document.getElementById('bg3d')
if (root && !window.__bg3dInitialized) {
  window.__bg3dInitialized = true
  createScene(root)
}
</script>