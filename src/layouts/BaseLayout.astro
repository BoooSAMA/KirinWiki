---
import "../styles/global.css"
import Navbar from "../components/Navbar.astro"
import MusicPlayer from "../components/MusicPlayer.astro"
import ClientRouter from "astro/components/ClientRouter.astro"
const { title } = Astro.props
---
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      // Inline blocking script — set initial theme before first paint to prevent flash
      (function() {
        try {
          const parts = new Intl.DateTimeFormat('en-SG', { timeZone: 'Asia/Singapore', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).format(new Date()).split(':')
          const hour = parseInt(parts[0]) || 12
          const palette = ['#0a0a1a','#0d0d20','#0f0f25','#12122a','#1a1a3e','#2a1a3e','#6a3050','#d4a060','#e8d8b0','#f0e8d0','#f8f4e8','#ffffff','#ffffff','#faf8f0','#f0ece0','#e8dcc8','#d4c098','#c89060','#b06040','#6a3050','#1a1a3e','#0d0d2b','#0a0a1a','#0a0a1a']
          const c = palette[hour % 24]
          const r = parseInt(c.slice(1,3),16)
          const g = parseInt(c.slice(3,5),16)
          const b = parseInt(c.slice(5,7),16)
          const brightness = 0.299*r + 0.587*g + 0.114*b
          document.documentElement.style.setProperty('--time-bg-color', c)
          document.body.style.backgroundColor = c
          if (brightness < 128) document.documentElement.dataset.theme = 'night'
        } catch(e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="text-[var(--glass-text)] min-h-screen font-sans">
    <div id="bg3d" data-astro-transition-persist="bg3d" style="position:fixed;inset:0;z-index:0;pointer-events:none"></div>
    <Navbar />
    <main class="max-w-4xl mx-auto px-6 py-12">
      <slot />
    </main>
    <MusicPlayer />
  </body>
</html>

<script>
import { createScene } from '../lib/crystalScene'
import { init as initTimeTheme } from '../lib/timeTheme'

const root = document.getElementById('bg3d')
if (root && !window.__bg3dInitialized) {
  window.__bg3dInitialized = true
  createScene(root)
}

// Start time-based theme after scene is created
initTimeTheme()
</script>

<script>
// ─── Floating FPS Monitor ───
// Toggle: Ctrl+Shift+F
(() => {
  if (window.__fpsMonitorInstalled) return
  window.__fpsMonitorInstalled = true

  const el = document.createElement('div')
  Object.assign(el.style, {
    position: 'fixed',
    bottom: '76px',
    left: '20px',
    zIndex: '2147483646',
    fontFamily: 'monospace',
    fontSize: '13px',
    lineHeight: '1.4',
    padding: '6px 10px',
    borderRadius: '8px',
    background: 'rgba(0,0,0,0.7)',
    color: '#fff',
    backdropFilter: 'blur(6px)',
    WebkitBackdropFilter: 'blur(6px)',
    border: '1px solid rgba(255,255,255,0.1)',
    display: 'none',
    pointerEvents: 'none',
    userSelect: 'none',
  })
  el.id = 'fps-monitor'
  el.textContent = '-- FPS'
  document.body.appendChild(el)

  let frames = 0
  let lastTime = performance.now()
  let fps = 0

  function tick(now) {
    frames++
    const delta = now - lastTime
    if (delta >= 1000) {
      fps = Math.round((frames * 1000) / delta)
      frames = 0
      lastTime = now

      el.textContent = `${fps} FPS`
      if (fps >= 55) el.style.color = '#4ade80'
      else if (fps >= 30) el.style.color = '#facc15'
      else el.style.color = '#f87171'
    }
    requestAnimationFrame(tick)
  }
  requestAnimationFrame(tick)

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.shiftKey && e.key === 'F') {
      e.preventDefault()
      el.style.display = el.style.display === 'none' ? 'block' : 'none'
    }
  })
})()
</script>