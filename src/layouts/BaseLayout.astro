---
import "../styles/global.css"
import Navbar from "../components/Navbar.astro"
import MusicPlayer from "../components/MusicPlayer.astro"
import ClientRouter from "astro/components/ClientRouter.astro"
const { title } = Astro.props
---
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      // Inline blocking script — set initial theme before first paint to prevent flash
      (function() {
        try {
          const parts = new Intl.DateTimeFormat('en-SG', { timeZone: 'Asia/Singapore', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).format(new Date()).split(':')
          const hour = parseInt(parts[0]) || 12
          const palette = ['#0a0a1a','#0d0d20','#0f0f25','#12122a','#1a1a3e','#2a1a3e','#6a3050','#d4a060','#e8d8b0','#f0e8d0','#f8f4e8','#ffffff','#ffffff','#faf8f0','#f0ece0','#e8dcc8','#d4c098','#c89060','#b06040','#6a3050','#1a1a3e','#0d0d2b','#0a0a1a','#0a0a1a']
          const c = palette[hour % 24]
          const r = parseInt(c.slice(1,3),16)
          const g = parseInt(c.slice(3,5),16)
          const b = parseInt(c.slice(5,7),16)
          const brightness = 0.299*r + 0.587*g + 0.114*b
          document.documentElement.style.setProperty('--time-bg-color', c)
          document.body.style.backgroundColor = c
          if (brightness < 128) document.documentElement.dataset.theme = 'night'
        } catch(e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="text-[var(--glass-text)] min-h-screen font-sans">
    <div id="bg3d" data-astro-transition-persist="bg3d" style="position:fixed;inset:0;z-index:0;pointer-events:none;contain:strict"></div>
    <Navbar />
    <main class="max-w-4xl mx-auto px-6 py-12">
      <slot />
    </main>
    <MusicPlayer />
  </body>
</html>

<script>
import { createScene } from '../lib/crystalScene'
import { init as initTimeTheme } from '../lib/timeTheme'

const root = document.getElementById('bg3d')
if (root && !window.__bg3dInitialized) {
  window.__bg3dInitialized = true
  createScene(root)
}

// Start time-based theme after scene is created
initTimeTheme()
</script>

<script>
// ─── Debug Panel (FPS + 3D Camera Coordinates) ───
// Toggle: Ctrl+Shift+F
(() => {
  if (window.__debugPanelInstalled) return
  window.__debugPanelInstalled = true

  const el = document.createElement('div')
  Object.assign(el.style, {
    position: 'fixed',
    top: '80px',
    left: '20px',
    zIndex: '2147483646',
    fontFamily: 'monospace',
    fontSize: '13px',
    lineHeight: '1.6',
    padding: '8px 12px',
    borderRadius: '8px',
    background: 'rgba(0,0,0,0.7)',
    color: '#fff',
    backdropFilter: 'blur(6px)',
    WebkitBackdropFilter: 'blur(6px)',
    border: '1px solid rgba(255,255,255,0.1)',
    display: 'none',
    pointerEvents: 'auto',
    userSelect: 'none',
    cursor: 'pointer',
    minWidth: '180px',
  })
  el.id = 'debug-panel'
  el.title = '点击复制 3D 坐标'
  document.body.appendChild(el)

  let frames = 0
  let lastTime = performance.now()
  let fps = 0

  function getCoordStr() {
    const s = window.__cameraState
    if (!s) return null
    return `pos (${s.pos.x.toFixed(2)}, ${s.pos.y.toFixed(2)}, ${s.pos.z.toFixed(2)})\nlook (${s.look.x.toFixed(2)}, ${s.look.y.toFixed(2)}, ${s.look.z.toFixed(2)})`
  }

  function getCoordClipText() {
    const s = window.__cameraState
    if (!s) return ''
    return `pos(${s.pos.x.toFixed(2)},${s.pos.y.toFixed(2)},${s.pos.z.toFixed(2)}),look(${s.look.x.toFixed(2)},${s.look.y.toFixed(2)},${s.look.z.toFixed(2)})`
  }

  el.onclick = () => {
    const text = getCoordClipText()
    if (!text) return
    navigator.clipboard.writeText(text).then(() => {
      const prev = el.innerHTML
      el.style.background = 'rgba(34,197,94,0.7)'
      el.textContent = '✓ 坐标已复制'
      el.style.color = '#fff'
      setTimeout(() => {
        el.style.background = 'rgba(0,0,0,0.7)'
        const s = window.__cameraState
        if (!s) { el.textContent = `${fps} FPS`; return }
        const fpsColor = fps >= 55 ? '#4ade80' : fps >= 30 ? '#facc15' : '#f87171'
        el.innerHTML = `<span style="color:${fpsColor}">${fps} FPS</span><span style="display:block;border-top:1px solid rgba(255,255,255,0.1);margin:4px 0"></span><span style="font-size:12px;opacity:0.8">pos ${s.pos.x.toFixed(2)}, ${s.pos.y.toFixed(2)}, ${s.pos.z.toFixed(2)}<br>look ${s.look.x.toFixed(2)}, ${s.look.y.toFixed(2)}, ${s.look.z.toFixed(2)}</span>`
      }, 1000)
    })
  }

  function tick(now) {
    frames++
    const delta = now - lastTime
    if (delta >= 1000) {
      fps = Math.round((frames * 1000) / delta)
      frames = 0
      lastTime = now

      const fpsColor = fps >= 55 ? '#4ade80' : fps >= 30 ? '#facc15' : '#f87171'
      const s = window.__cameraState
      if (s && el.style.display !== 'none' && !el.dataset.copied) {
        el.innerHTML = `<span style="color:${fpsColor}">${fps} FPS</span><span style="display:block;border-top:1px solid rgba(255,255,255,0.1);margin:4px 0"></span><span style="font-size:12px;opacity:0.8">pos ${s.pos.x.toFixed(2)}, ${s.pos.y.toFixed(2)}, ${s.pos.z.toFixed(2)}<br>look ${s.look.x.toFixed(2)}, ${s.look.y.toFixed(2)}, ${s.look.z.toFixed(2)}</span>`
      } else if (el.style.display !== 'none') {
        el.innerHTML = `<span style="color:${fpsColor}">${fps} FPS</span><span style="display:block;border-top:1px solid rgba(255,255,255,0.1);margin:4px 0"></span><span style="font-size:12px;opacity:0.5">3D scene loading…</span>`
      }
    }
    requestAnimationFrame(tick)
  }
  requestAnimationFrame(tick)

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.shiftKey && e.key === 'F') {
      e.preventDefault()
      el.style.display = el.style.display === 'none' ? 'block' : 'none'
      if (el.style.display === 'block') {
        el.dataset.copied = ''
      }
    }
  })
})()
</script>